+struct AsyncCloseSource final : server::Source {
+    Value prototype=TypeDef(TypeCode::Struct, {members::Int32("value")}).create();
+    std::shared_ptr<server::ChannelControl> channel;
+    std::atomic<unsigned> created{0u}, closedCount{0u};
+    epicsEvent closed;
+
+    void onSearch(Search& op) override final { for(auto& name : op) name.claim(); }
+    void onCreate(std::unique_ptr<server::ChannelControl>&& op) override final
+    {
+        if(created.fetch_add(1u)) return;
+        channel=std::move(op);
+        channel->onClose([this](const std::string&) { ++closedCount; closed.signal(); });
+        channel->onOp([this](std::unique_ptr<server::ConnectOp>&& op) {
+            op->onGet([this](std::unique_ptr<server::ExecOp>&& op) {
+                op->error(RemoteStatus(RemoteStatus::Fatal, "timeout before close", "remote timeout stack"));
+                auto control=std::move(channel);
+                control->closeAsync();
+                control->closeAsync();
+                // Destruction here must not invalidate either queued close.
+            });
+            op->connect(prototype);
+        });
+    }
+};
+
+void testAsyncCloseOrdering()
+{
+    auto source=std::make_shared<AsyncCloseSource>();
+    auto serv=server::Config::isolated().build().addSource("async-close", source).start();
+    auto cli=serv.clientConfig().build();
+    epicsEvent connected, disconnected, completed;
+    std::atomic<bool> wasConnected{false}, disconnectedBeforeError{false};
+    std::atomic<unsigned> results{0u};
+    client::Result result;
+    auto connector=cli.connect("async-close")
+            .onConnect([&]() { wasConnected=true; connected.signal(); })
+            .onDisconnect([&]() {
+                if(wasConnected.exchange(false)) {
+                    if(!results.load()) disconnectedBeforeError=true;
+                    disconnected.signal();
+                }
+            }).exec();
+    if(!connected.wait(5.0)) throw std::runtime_error("Async-close channel did not connect");
+    auto get=cli.get("async-close").result([&](client::Result&& value) {
+        result=std::move(value); ++results; completed.signal();
+    }).exec();
+    testTrue(completed.wait(5.0));
+    testTrue(disconnected.wait(5.0));
+    testTrue(source->closed.wait(5.0));
+    testFalse(disconnectedBeforeError.load());
+    testEq(results.load(), 1u);
+    testEq(source->closedCount.load(), 1u);
+    testFalse(bool(source->channel));
+    testTrue(result.error());
+    testEq(result.status().severity, RemoteStatus::Fatal);
+    testEq(result.status().stack, "remote timeout stack");
+    testThrowsMatch<client::RemoteError>("timeout before close", [&]() { result(); });
+    serv.stop();
+    testEq(source->closedCount.load(), 1u);
+}
+
+void testTransportClose()
+{
+    auto source=std::make_shared<ProxySource>();
+    auto serv=server::Config::isolated().build().addSource("proxy", source).start();
+    {
+        auto cli=serv.clientConfig().build();
+        auto process=cli.proxy("transport-close", ProxyKind::Process).exec();
+        testFalse(execute(process, ProxyRequest()));
+    }
+    testTrue(source->channelClosed.wait(5.0));
+    testEq(source->nChannelClosed.load(), 1u);
+    serv.stop();
+    testEq(source->nChannelClosed.load(), 1u);
+}
