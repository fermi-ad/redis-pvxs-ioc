+struct AdmissionSource : server::Source {
+    Value prototype=nt::NTScalar{TypeCode::Int32}.create();
+    std::atomic<unsigned> gets{0}, puts{0}, rpcs{0};
+    bool drop=false;
+    AdmissionSource() { prototype["value"]=19; }
+    void onSearch(Search& search) override { for(auto& name : search) name.claim(); }
+    void onCreate(std::unique_ptr<server::ChannelControl>&& raw) override {
+        std::shared_ptr<server::ChannelControl> channel(std::move(raw));
+        channel->onOp([this, channel](std::unique_ptr<server::ConnectOp>&& op) {
+            op->onGet([this, channel](std::unique_ptr<server::ExecOp>&& exec) {
+                auto count=++gets;
+                if(drop && count==1) channel->close();
+                else exec->reply(prototype);
+            });
+            op->onPut([this, channel](std::unique_ptr<server::ExecOp>&& exec, Value&&) {
+                auto count=++puts;
+                if(drop && count==1) channel->close();
+                else exec->reply();
+            });
+            op->connect(prototype);
+        });
+        channel->onRPC([this, channel](std::unique_ptr<server::ExecOp>&& exec, Value&& value) {
+            auto count=++rpcs;
+            if(drop && count==1) channel->close();
+            else exec->reply(value);
+        });
+    }
+};
