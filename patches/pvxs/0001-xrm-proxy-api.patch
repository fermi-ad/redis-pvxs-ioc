@@ -0,0 +1,71 @@
+/** Project-owned PVA proxy extensions against the bundled PVXS source. */
+#ifndef PVXS_PROXY_H
+#define PVXS_PROXY_H
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+#include <pvxs/data.h>
+
+#define PVXS_PROJECT_PROXY_API 1
+#define PVXS_XRM_PROXY_API 1
+
+namespace pvxs {
+
+/** Link-time check that headers and library carry the same proxy extension. */
+PVXS_API int xrmProxyApiVersion();
+
+/** Native PVA status, including successful warnings and remote stack text. */
+struct RemoteStatus {
+    enum Severity : uint8_t { Ok = 0, Warning = 1, Error = 2, Fatal = 3 };
+    Severity severity = Ok;
+    std::string message;
+    std::string stack;
+
+    RemoteStatus() = default;
+    RemoteStatus(Severity severity, const std::string& message = std::string(),
+                 const std::string& stack = std::string())
+        : severity(severity), message(message), stack(stack) {}
+    bool isSuccess() const { return severity == Ok || severity == Warning; }
+    bool isDefault() const { return severity == Ok && message.empty() && stack.empty(); }
+};
+
+enum class ProxyKind : uint8_t { Process = 16, PutGet = 12, Array = 14 };
+
+enum class ProxyAction : uint8_t {
+    Process, PutGet, GetPut, GetGet,
+    ArrayGet, ArrayPut, ArrayGetLength, ArraySetLength
+};
+
+struct ProxyRequest {
+    ProxyAction action = ProxyAction::Process;
+    Value value;
+    uint64_t offset = 0;
+    uint64_t count = 0;
+    uint64_t stride = 1;
+    uint64_t length = 0;
+
+    bool mutating() const {
+        return action == ProxyAction::Process || action == ProxyAction::PutGet ||
+               action == ProxyAction::ArrayPut || action == ProxyAction::ArraySetLength;
+    }
+};
+
+struct ProxyPrototype {
+    Value put;
+    Value get;
+};
+
+/** One monitor update and the field indexes reported as overrun by the source. */
+struct MonitorEvent {
+    Value value;
+    std::vector<size_t> overrun;
+    RemoteStatus status;
+    // A transport-local reservation retained with this queued value.
+    std::shared_ptr<void> lease;
+};
+
+} // namespace pvxs
+#endif
