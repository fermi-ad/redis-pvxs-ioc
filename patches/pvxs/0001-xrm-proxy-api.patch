+void monitorPauseAsync() {
+    Fixture f;
+    epicsEvent entered, release;
+    std::atomic<bool> first{true};
+    auto sub=f.cli.monitor("value").event([&](client::Subscription&) {
+        if(first.exchange(false)) { entered.signal(); release.wait(5.0); }
+    }).exec();
+    testOk1(entered.wait(5.0));
+    auto start=epicsTime::getCurrent();
+    sub->pauseAsync(true);
+    testTrue(epicsTime::getCurrent()-start < 1.0);
+    release.signal();
+    sub->cancel();
+}
