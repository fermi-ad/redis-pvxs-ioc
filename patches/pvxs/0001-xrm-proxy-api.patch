+RemoteStatus warning() { return RemoteStatus(RemoteStatus::Warning, "native warning", "warning stack"); }
+RemoteStatus remoteFailure(bool fatal=false) {
+    return RemoteStatus(fatal ? RemoteStatus::Fatal : RemoteStatus::Error,
+                        fatal ? "native fatal" : "native error", "remote stack");
+}
+void checkStatus(const RemoteStatus& actual, const RemoteStatus& expected) {
+    testEq(actual.severity, expected.severity);
+    testEq(actual.message, expected.message);
+    testEq(actual.stack, expected.stack);
+}
+struct StatusSource : server::Source {
+    Value prototype=nt::NTScalar{TypeCode::Int32}.create();
+    StatusSource() { prototype["value"]=39; }
+    void onSearch(Search& search) override { for(auto& name : search) name.claim(); }
+    void onCreate(std::unique_ptr<server::ChannelControl>&& raw) override {
+        const std::string name(raw->name());
+        raw->onOp([this, name](std::unique_ptr<server::ConnectOp>&& op) {
+            if(name=="setup-error") { op->error(remoteFailure()); return; }
+            op->onGet([this, name](std::unique_ptr<server::ExecOp>&& exec) {
+                if(name=="error" || name=="fatal") exec->error(remoteFailure(name=="fatal"));
+                else exec->reply(prototype, warning());
+            });
+            op->onPut([name](std::unique_ptr<server::ExecOp>&& exec, Value&&) {
+                if(name=="error" || name=="fatal") exec->error(remoteFailure(name=="fatal"));
+                else exec->reply(warning());
+            });
+            op->connect(prototype, warning());
+        });
+        raw->onRPC([name](std::unique_ptr<server::ExecOp>&& exec, Value&& value) {
+            if(name=="error" || name=="fatal") exec->error(remoteFailure(name=="fatal"));
+            else exec->reply(value, warning());
+        });
+        raw->onProxy([name](std::unique_ptr<server::ProxySetupOp>&& op) {
+            if(name=="setup-error") { op->error(remoteFailure()); return; }
+            op->onExec([name](std::unique_ptr<server::ProxyExecOp>&& exec, ProxyRequest&&) {
+                if(name=="error" || name=="fatal") exec->error(remoteFailure(name=="fatal"));
+                else exec->reply(warning());
+            });
+            op->connect(ProxyPrototype{}, warning());
+        });
+        raw->onSubscribe([this, name](std::unique_ptr<server::MonitorSetupOp>&& op) {
+            auto monitor=op->connect(prototype, warning());
+            auto value=prototype.clone();
+            monitor->post(value);
+            if(name=="error" || name=="fatal") monitor->error(remoteFailure(name=="fatal"));
+            else monitor->finish(warning());
+        });
+    }
+};
