+struct DeltaProxySource : AdmissionSource {
+    Value deltaType=TypeDef(TypeCode::Struct, {members::Int32("changing"), members::String("fixed")}).create();
+    unsigned putReads=0, getReads=0;
+    void onCreate(std::unique_ptr<server::ChannelControl>&& raw) override {
+        raw->onProxy([this](std::unique_ptr<server::ProxySetupOp>&& op) {
+            op->onExec([this](std::unique_ptr<server::ProxyExecOp>&& exec, ProxyRequest&& request) {
+                auto value=deltaType.cloneEmpty();
+                if(request.action==ProxyAction::GetPut) {
+                    value["changing"]=int32_t(++putReads);
+                    if(putReads==1) value["fixed"]="put";
+                } else {
+                    value["changing"]=int32_t(10u*(++getReads));
+                    if(getReads==1) value["fixed"]="get";
+                }
+                exec->reply(value);
+            });
+            ProxyPrototype prototype; prototype.put=deltaType; prototype.get=deltaType;
+            op->connect(prototype);
+        });
+    }
+};
+void proxyDeltaCaches() {
+    auto source=std::make_shared<DeltaProxySource>();
+    auto serv=server::Config::isolated().build().addSource("delta", source).start();
+    auto cli=serv.clientConfig().build();
+    auto op=cli.proxy("value", ProxyKind::PutGet).exec();
+    epicsEvent done;
+    client::Result result;
+    auto run=[&](const ProxyRequest& request) -> Value {
+        op->execute(request, [&](client::Result&& value) { result=std::move(value); done.signal(); });
+        testOk1(done.wait(5.0));
+        return result();
+    };
+    ProxyRequest request; request.action=ProxyAction::GetPut;
+    auto firstPut=run(request);
+    testEq(firstPut["fixed"].as<std::string>(), std::string("put"));
+    request.action=ProxyAction::GetGet;
+    auto firstGet=run(request);
+    testEq(firstGet["fixed"].as<std::string>(), std::string("get"));
+    firstGet["fixed"]="caller-mutated";
+    request.action=ProxyAction::PutGet;
+    request.value=source->deltaType.cloneEmpty(); request.value["fixed"]="written";
+    auto written=run(request);
+    testEq(written["changing"].as<int32_t>(), 20);
+    testEq(written["fixed"].as<std::string>(), std::string("get"));
+    testTrue(written["changing"].isMarked()); testFalse(written["fixed"].isMarked());
+    request.action=ProxyAction::GetPut; request.value=Value();
+    auto secondPut=run(request);
+    testEq(secondPut["changing"].as<int32_t>(), 2);
+    testEq(secondPut["fixed"].as<std::string>(), std::string("written"));
+    testTrue(secondPut["changing"].isMarked()); testFalse(secondPut["fixed"].isMarked());
+    request.action=ProxyAction::GetGet;
+    auto secondGet=run(request);
+    testEq(secondGet["changing"].as<int32_t>(), 30);
+    testEq(secondGet["fixed"].as<std::string>(), std::string("get"));
+    testTrue(secondGet["changing"].isMarked()); testFalse(secondGet["fixed"].isMarked());
+    request.action=ProxyAction::PutGet;
+    request.value=source->deltaType.cloneEmpty();
+    request.value["changing"]=100; request.value["fixed"]="root-written";
+    request.value.unmark(); request.value.mark();
+    run(request);
+    request.action=ProxyAction::GetPut; request.value=Value();
+    auto afterRootWrite=run(request);
+    testEq(afterRootWrite["fixed"].as<std::string>(), std::string("root-written"));
+    testFalse(afterRootWrite["fixed"].isMarked());
+}
