+void nativeStatus() {
+    auto source=std::make_shared<StatusSource>();
+    auto serv=server::Config::isolated().build().addSource("status", source).start();
+    auto cli=serv.clientConfig().build();
+    client::Result result;
+    epicsEvent done;
+    auto callback=[&](client::Result&& value) { result=std::move(value); done.signal(); };
+    auto get=cli.get("warn").onInit([&](const Value&, const RemoteStatus& status) { checkStatus(status, warning()); })
+        .result(callback).exec();
+    testOk1(done.wait(5.0));
+    testFalse(result.error()); checkStatus(result.status(), warning());
+    testEq(result()["value"].as<int32_t>(), 39);
+    auto info=cli.info("warn").result(callback).exec();
+    testOk1(done.wait(5.0)); testFalse(result.error()); checkStatus(result.status(), warning());
+    auto put=cli.put("warn").fetchPresent(false).set("value", 41)
+        .onInit([&](const Value&, const RemoteStatus& status) { checkStatus(status, warning()); })
+        .result(callback).exec();
+    testOk1(done.wait(5.0)); testFalse(result.error()); checkStatus(result.status(), warning());
+    auto rpc=cli.rpc("warn", source->prototype)
+        .onInit([&](const Value&, const RemoteStatus& status) { checkStatus(status, RemoteStatus{}); })
+        .result(callback).exec();
+    testOk1(done.wait(5.0)); testFalse(result.error()); checkStatus(result.status(), warning());
+    for(auto name : {"error", "fatal", "setup-error"}) {
+        auto expected=remoteFailure(std::string(name)=="fatal");
+        auto fail=cli.get(name).result(callback).exec();
+        testOk1(done.wait(5.0)); testTrue(result.error()); checkStatus(result.status(), expected);
+        try { result(); testFail("Expected RemoteError"); }
+        catch(client::RemoteError& error) { checkStatus(error.status(), expected); }
+    }
+    auto process=cli.proxy("warn", ProxyKind::Process)
+        .onInit([&](const ProxyPrototype&, const RemoteStatus& status) { checkStatus(status, warning()); }).exec();
+    process->execute(ProxyRequest{}, callback);
+    testOk1(done.wait(5.0)); testFalse(result.error()); checkStatus(result.status(), warning());
+    auto badprocess=cli.proxy("fatal", ProxyKind::Process).exec();
+    badprocess->execute(ProxyRequest{}, callback);
+    testOk1(done.wait(5.0)); testTrue(result.error()); checkStatus(result.status(), remoteFailure(true));
+}
