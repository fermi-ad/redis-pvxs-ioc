+struct CallbackCounter {
+    std::atomic<unsigned> calls{0};
+    epicsEvent done;
+};
+void proxyCallbackOnce() {
+    auto source=std::make_shared<StatusSource>();
+    auto serv=server::Config::isolated().build().addSource("once", source).start();
+    auto cli=serv.clientConfig().build();
+    CallbackCounter success, setupError, executionError;
+    auto op=cli.proxy("warn", ProxyKind::Process).exec();
+    op->execute(ProxyRequest{}, [&success](client::Result&&) { ++success.calls; success.done.signal(); });
+    testOk1(success.done.wait(5.0));
+    testTrue(op->cancel());
+    testEq(success.calls.load(), 1u);
+    testFalse(op->cancel());
+    testEq(success.calls.load(), 1u);
+
+    auto bad=cli.proxy("setup-error", ProxyKind::Process)
+        .result([&setupError](client::Result&&) { ++setupError.calls; setupError.done.signal(); }).exec();
+    bad->execute(ProxyRequest{}, [&executionError](client::Result&&) { ++executionError.calls; executionError.done.signal(); });
+    testOk1(setupError.done.wait(5.0));
+    testOk1(executionError.done.wait(5.0));
+    testFalse(bad->cancel());
+    testEq(setupError.calls.load(), 1u);
+    testEq(executionError.calls.load(), 1u);
+
+    CallbackCounter guardError;
+    auto denied=cli.proxy("warn", ProxyKind::Process).beforeSend([]() { throw std::runtime_error("denied"); }).exec();
+    denied->execute(ProxyRequest{}, [&guardError](client::Result&&) { ++guardError.calls; guardError.done.signal(); });
+    testOk1(guardError.done.wait(5.0));
+    testTrue(denied->cancel());
+    testEq(guardError.calls.load(), 1u);
+
+    auto delayed=std::make_shared<DelayedProxySource>();
+    auto delayedServer=server::Config::isolated().build().addSource("delayed", delayed).start();
+    auto delayedClient=delayedServer.clientConfig().build();
+    CallbackCounter canceled;
+    auto queued=delayedClient.proxy("value", ProxyKind::Process).exec();
+    queued->execute(ProxyRequest{}, [&canceled](client::Result&&) { ++canceled.calls; canceled.done.signal(); });
+    testOk1(delayed->setup.wait(5.0));
+    testTrue(queued->cancel());
+    testOk1(canceled.done.wait(5.0));
+    testFalse(queued->cancel());
+    delayed->held->connect(ProxyPrototype{}); delayed->held.reset();
+    testTrue(bool(delayedClient.info("value").exec()->wait(5.0)));
+    testEq(canceled.calls.load(), 1u);
+}
