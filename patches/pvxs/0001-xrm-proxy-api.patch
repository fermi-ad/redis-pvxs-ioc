+struct ProxySource final : server::Source {
+    Value put = TypeDef(TypeCode::Struct, {members::Int32("input")}).create();
+    Value get = TypeDef(TypeCode::Struct, {members::Int64("output")}).create();
+    Value array = TypeDef(TypeCode::Int32A).create();
+    uint64_t length = 5u;
+    ProxyRequest last;
+    std::atomic<unsigned> nProcess{0u};
+    std::atomic<unsigned> nChannelClosed{0u};
+    epicsEvent channelClosed;
+    std::string subfield;
+    struct LeaseState {
+        std::atomic<unsigned> freed{0u};
+        epicsEvent allFreed;
+    };
+    std::shared_ptr<LeaseState> leaseState = std::make_shared<LeaseState>();
+    std::vector<std::weak_ptr<void>> leases;
+    epicsEvent leasesQueued, releaseLeases;
+    std::shared_ptr<server::MonitorControlOp> mon;
+    epicsEvent cancelStarted, canceled, closed;
+    std::unique_ptr<server::ProxyExecOp> held;
+
+    void onSearch(Search& op) override final { for(auto& name : op) name.claim(); }
+    void onCreate(std::unique_ptr<server::ChannelControl>&& op) override final
+    {
+        auto chan = std::move(op);
+        const auto name = chan->name();
+        // A small trivial closure exercises implementations where moving a
+        // std::function leaves the original target engaged.
+        chan->onClose([this](const std::string&) {
+            nChannelClosed++;
+            channelClosed.signal();
+        });
+        if(name=="proxyonly") {
+            chan->onProxy([](std::unique_ptr<server::ProxySetupOp>&& setup) {
+                setup->onExec([](std::unique_ptr<server::ProxyExecOp>&& exec, ProxyRequest&&) {
+                    exec->reply();
+                });
+                setup->connect(ProxyPrototype{});
+            });
+            return;
+        }
+        chan->onOp([this](std::unique_ptr<server::ConnectOp>&& op) {
+            subfield = op->subField();
+            op->connect(subfield.empty() ? put : put[subfield]);
+        });
+        chan->onSubscribe([this, name](std::unique_ptr<server::MonitorSetupOp>&& op) {
+            mon = op->connect(put);
+            if(name=="lease") {
+                for(int32_t value=0; value<6; value++) {
+                    MonitorEvent event;
+                    event.value = put.cloneEmpty();
+                    event.value["input"] = value;
+                    auto state = leaseState;
+                    event.lease = std::shared_ptr<void>(new int(value), [state](void* ptr) {
+                        delete static_cast<int*>(ptr);
+                        if(++state->freed==6u) state->allFreed.signal();
+                    });
+                    leases.push_back(event.lease);
+                    mon->postEvent(event);
+                }
+                leasesQueued.signal();
+                if(!releaseLeases.wait(5.0))
+                    throw std::runtime_error("Timed out waiting for lease inspection");
+                mon->finish();
+                return;
+            }
+            if(name=="squash") {
+                // Queue while stopped to force two local squashes of the last entry.
+                for(int32_t value=0; value<6; value++) {
+                    auto event = put.cloneEmpty();
+                    event["input"] = value;
+                    mon->post(event);
+                }
+                mon->finish();
+                return;
+            }
+            mon->onStart([this](bool start) {
+                if(!start) return;
+                MonitorEvent event;
+                event.value = put.cloneEmpty();
+                event.value["input"] = 42;
+                event.overrun = {1u};
+                mon->postEvent(event);
+                mon->error("upstream monitor failed");
+            });
+        });
+        if(name=="unsupported")
+            return;
+        chan->onProxy([this, name](std::unique_ptr<server::ProxySetupOp>&& op) {
+            ProxyPrototype proto;
+            if(op->kind()==ProxyKind::PutGet) {
+                proto.put = put;
+                proto.get = get;
+            } else if(op->kind()==ProxyKind::Array) {
+                proto.put = proto.get = array;
+            }
+            op->onClose([this](const std::string&) { closed.signal(); });
+            if(name=="noexec") {
+                op->connect(proto);
+                return;
+            }
+            op->onExec([this, name](std::unique_ptr<server::ProxyExecOp>&& op, ProxyRequest&& request) {
+                last = request;
+                if(name=="cancel") {
+                    op->onCancel([this]() { canceled.signal(); });
+                    held = std::move(op);
+                    cancelStarted.signal();
+                    return;
+                }
+                if(name=="error") {
+                    op->error("upstream execution failed");
+                    return;
+                }
+                switch(request.action) {
+                case ProxyAction::Process:
+                    nProcess++;
+                    op->reply();
+                    break;
+                case ProxyAction::GetPut: {
+                    auto value = put.cloneEmpty();
+                    value["input"] = 3;
+                    op->reply(value);
+                    break;
+                }
+                case ProxyAction::GetGet:
+                case ProxyAction::PutGet: {
+                    auto value = get.cloneEmpty();
+                    value["output"] = request.action==ProxyAction::GetGet ? 77 : request.value["input"].as<int32_t>()*2;
+                    op->reply(value);
+                    break;
+                }
+                case ProxyAction::ArrayGet: {
+                    auto value = array.cloneEmpty();
+                    value = shared_array<const int32_t>({11, 33});
+                    op->reply(value);
+                    break;
+                }
+                case ProxyAction::ArrayPut:
+                    op->reply();
+                    break;
+                case ProxyAction::ArraySetLength:
+                    length = request.length;
+                    op->reply();
+                    break;
+                case ProxyAction::ArrayGetLength:
+                    op->replyLength(length);
+                    break;
+                }
+            });
+            op->connect(proto);
+        });
+    }
+};
+
+struct Completion {
+    epicsEvent done;
+    client::Result result;
+    void operator()(client::Result&& value) { result=std::move(value); done.signal(); }
+    Value wait() {
+        if(!done.wait(5.0))
+            throw std::runtime_error("Timed out waiting for native proxy execution");
+        return result();
+    }
+};
+
+Value execute(const std::shared_ptr<client::ProxyOperation>& op, const ProxyRequest& request)
+{
+    Completion completion;
+    op->execute(request, [&completion](client::Result&& result) { completion(std::move(result)); });
+    return completion.wait();
+}
+
+void testNative()
+{
+    auto source = std::make_shared<ProxySource>();
+    auto serv = server::Config::isolated().build().addSource("proxy", source).start();
+    auto cli = serv.clientConfig().build();
+
+    ProxyRequest request;
+    auto proxyOnly = cli.proxy("proxyonly", ProxyKind::Process).exec();
+    testFalse(execute(proxyOnly, request));
+    auto process = cli.proxy("proxy", ProxyKind::Process).exec();
+    testFalse(execute(process, request));
+    testEq(source->nProcess.load(), 1u);
+
+    ProxyPrototype prototype;
+    epicsEvent initialized;
+    auto putget = cli.proxy("proxy", ProxyKind::PutGet)
+            .onInit([&](const ProxyPrototype& value) { prototype=value; initialized.signal(); }).exec();
+    if(!initialized.wait(5.0))
+        throw std::runtime_error("PUT_GET setup did not complete");
+    testTrue(!!prototype.put["input"]);
+    testTrue(!!prototype.get["output"]);
+    testFalse(prototype.put.equalType(prototype.get));
+    request.action=ProxyAction::GetPut;
+    testEq(execute(putget, request)["input"].as<int32_t>(), 3);
+    request.action=ProxyAction::GetGet;
+    testEq(execute(putget, request)["output"].as<int64_t>(), 77);
+    request.action=ProxyAction::PutGet;
+    request.value=prototype.put.cloneEmpty();
+    request.value["input"]=8;
+    testEq(execute(putget, request)["output"].as<int64_t>(), 16);
+
+    ProxyPrototype arrayPrototype;
+    epicsEvent arrayInitialized;
+    auto array = cli.proxy("proxy", ProxyKind::Array)
+            .onInit([&](const ProxyPrototype& value) { arrayPrototype=value; arrayInitialized.signal(); }).exec();
+    if(!arrayInitialized.wait(5.0))
+        throw std::runtime_error("ARRAY setup did not complete");
+    testEq(arrayPrototype.get.type(), TypeCode(TypeCode::Int32A));
+    request=ProxyRequest();
+    request.action=ProxyAction::ArrayGet;
+    request.offset=260u;
+    request.count=2u;
+    request.stride=3u;
+    auto values=execute(array, request).as<shared_array<const int32_t>>();
+    testEq(values.size(), 2u);
+    testEq(values[0], 11);
+    testEq(values[1], 33);
+    testEq(source->last.offset, 260u);
+    testEq(source->last.count, 2u);
+    testEq(source->last.stride, 3u);
+    request.action=ProxyAction::ArrayPut;
+    request.value=arrayPrototype.put.cloneEmpty();
+    request.value=shared_array<const int32_t>({7, 9});
+    testFalse(execute(array, request));
+    testEq(source->last.value.as<shared_array<const int32_t>>()[1], 9);
+    testEq(source->last.offset, 260u);
+    testEq(source->last.count, 2u);
+    testEq(source->last.stride, 3u);
+    request=ProxyRequest();
+    request.action=ProxyAction::ArraySetLength;
+    request.length=265u;
+    testFalse(execute(array, request));
+    request.action=ProxyAction::ArrayGetLength;
+    testEq(execute(array, request).as<uint64_t>(), 265u);
+
+    request=ProxyRequest();
+    auto error=cli.proxy("error", ProxyKind::Process).exec();
+    testThrowsMatch<client::RemoteError>("upstream execution failed", [&]() { execute(error, request); });
+    auto unsupported=cli.proxy("unsupported", ProxyKind::Process).exec();
+    testThrowsMatch<client::RemoteError>(".*not implemented.*", [&]() { execute(unsupported, request); });
+    auto noexec=cli.proxy("noexec", ProxyKind::Process).exec();
+    testThrowsMatch<client::RemoteError>(".*not implemented.*", [&]() { execute(noexec, request); });
+
+    auto field=cli.info("proxy").subField("input").exec()->wait(5.0);
+    testEq(field.type(), TypeCode(TypeCode::Int32));
+    testEq(source->subfield, "input");
+
+    epicsEvent update;
+    auto monitor=cli.monitor("proxy").maskConnected(true).maskDisconnected(true)
+            .event([&](client::Subscription&) { update.signal(); }).exec();
+    MonitorEvent event;
+    for(unsigned attempt=0u; attempt<5u && !event.value; attempt++) {
+        event=monitor->popEvent();
+        if(!event.value) update.wait(1.0);
+    }
+    testTrue(!!event.value);
+    testEq(event.value["input"].as<int32_t>(), 42);
+    testEq(event.overrun.size(), 1u);
+    if(!event.overrun.empty()) testEq(event.overrun[0], 1u);
+    // The terminal status may arrive in a later frame.
+    bool terminalError=false;
+    for(unsigned attempt=0u; attempt<5u && !terminalError; attempt++) {
+        try {
+            auto ignored=monitor->popEvent();
+            (void)ignored;
+            update.wait(1.0);
+        } catch(client::RemoteError& e) {
+            terminalError=std::string(e.what()).find("upstream monitor failed")!=std::string::npos;
+        }
+    }
+    testTrue(terminalError);
+
+    epicsEvent squashedUpdate;
+    auto squashed=cli.monitor("squash").maskConnected(true).maskDisconnected(true)
+            .event([&](client::Subscription&) { squashedUpdate.signal(); }).exec();
+    unsigned received=0u;
+    MonitorEvent last;
+    for(unsigned attempt=0u; attempt<20u && received<4u; attempt++) {
+        auto event=squashed->popEvent();
+        if(!event.value) {
+            squashedUpdate.wait(0.25);
+            continue;
+        }
+        received++;
+        last=std::move(event);
+    }
+    testEq(received, 4u);
+    testEq(last.value["input"].as<int32_t>(), 5);
+    testEq(last.overrun.size(), 1u);
+    if(!last.overrun.empty()) testEq(last.overrun[0], 1u);
+    bool normalFinish=false;
+    for(unsigned attempt=0u; attempt<20u && !normalFinish; attempt++) {
+        try {
+            auto ignored=squashed->popEvent();
+            (void)ignored;
+            squashedUpdate.wait(0.25);
+        } catch(client::Finished&) {
+            normalFinish=true;
+        }
+    }
+    testTrue(normalFinish);
+
+    // A stopped queue must own both original and squashed reservations.
+    epicsEvent leasedUpdate;
+    auto leased=cli.monitor("lease").maskConnected(true).maskDisconnected(true)
+            .event([&](client::Subscription&) { leasedUpdate.signal(); }).exec();
+    testTrue(source->leasesQueued.wait(5.0));
+    testEq(source->leaseState->freed.load(), 0u);
+    testEq(source->leases.size(), 6u);
+    bool allAlive=true;
+    for(auto& lease : source->leases) allAlive=allAlive && !lease.expired();
+    testTrue(allAlive);
+    source->releaseLeases.signal();
+    testTrue(source->leaseState->allFreed.wait(5.0));
+    testEq(source->leaseState->freed.load(), 6u);
+    bool allExpired=true;
+    for(auto& lease : source->leases) allExpired=allExpired && lease.expired();
+    testTrue(allExpired);
+    MonitorEvent unsupportedStatus;
+    unsupportedStatus.value=source->put.cloneEmpty();
+    unsupportedStatus.status=RemoteStatus(RemoteStatus::Warning, "no wire slot", "remote stack");
+    testThrowsMatch<std::invalid_argument>(".*cannot carry a status.*", [&]() {
+        source->mon->postEvent(unsupportedStatus);
+    });
+
+    auto canceled=cli.proxy("cancel", ProxyKind::Process).exec();
+    Completion completion;
+    canceled->execute(ProxyRequest(), [&completion](client::Result&& result) { completion(std::move(result)); });
+    testTrue(source->cancelStarted.wait(5.0));
+    testTrue(canceled->cancel());
+    testTrue(source->canceled.wait(5.0));
+    testTrue(source->closed.wait(5.0));
+    testThrows<client::Interrupted>([&]() { completion.wait(); });
+    source->held.reset();
+}
+
+struct GenerationSource final : server::Source {
+    Value prototype=TypeDef(TypeCode::Struct, {members::Int32("value")}).create();
+    std::vector<std::unique_ptr<server::ExecOp>> executions;
+    epicsEvent entered, firstCanceled, currentCanceled;
+    std::atomic<unsigned> nFirstCanceled{0u}, nCurrentCanceled{0u}, nStaleCanceled{0u};
+
+    void onSearch(Search& op) override final { for(auto& name : op) name.claim(); }
+    void onCreate(std::unique_ptr<server::ChannelControl>&& op) override final
+    {
+        auto channel=std::move(op);
+        channel->onOp([this](std::unique_ptr<server::ConnectOp>&& op) {
+            op->onGet([this](std::unique_ptr<server::ExecOp>&& op) {
+                if(executions.empty()) {
+                    op->onCancel([this]() { ++nFirstCanceled; firstCanceled.signal(); });
+                } else {
+                    op->onCancel([this]() { ++nCurrentCanceled; currentCanceled.signal(); });
+                }
+                executions.emplace_back(std::move(op));
+                entered.signal();
+            });
+            op->connect(prototype);
+        });
+    }
+};
+
+// The public cancel API destroys an operation.  Inject native CANCEL_REQUEST
+// and EXEC frames to exercise the protocol's reusable IOID without changing
+// the client state which is still waiting for its execution result.
+void sendNativeGetControl(const std::shared_ptr<client::Operation>& operation, bool cancel, bool execute)
+{
+    auto base=static_cast<client::OperationBase*>(operation.get());
+    base->loop.call([base, cancel, execute]() {
+        auto conn=base->chan->conn;
+        impl::EvOutBuf wire(conn->sendBE, bufferevent_get_output(conn->connection()));
+        if(cancel) {
+            to_wire(wire, impl::Header{impl::CMD_CANCEL_REQUEST, 0u, 8u});
+            to_wire(wire, base->chan->sid);
+            to_wire(wire, base->ioid);
+        }
+        if(execute) {
+            to_wire(wire, impl::Header{impl::CMD_GET, 0u, 9u});
+            to_wire(wire, base->chan->sid);
+            to_wire(wire, base->ioid);
+            to_wire(wire, uint8_t(0u));
+        }
+        if(!wire.good()) throw std::runtime_error("Unable to encode native GET control");
+    });
+}
+
+void testGenerationFence()
+{
+    auto source=std::make_shared<GenerationSource>();
+    auto serv=server::Config::isolated().build().addSource("generation", source).start();
+    auto cli=serv.clientConfig().build();
+    epicsEvent initialized, completed;
+    client::Result result;
+    auto get=cli.get("generation").autoExec(false)
+            .onInit([&](const Value&) { initialized.signal(); }).exec();
+    if(!initialized.wait(5.0)) throw std::runtime_error("GET setup did not complete");
+    get->reExecGet([&](client::Result&& value) { result=std::move(value); completed.signal(); });
+    if(!source->entered.wait(5.0)) throw std::runtime_error("First GET execution did not arrive");
+    sendNativeGetControl(get, true, true);
+    testTrue(source->firstCanceled.wait(5.0));
+    if(!source->entered.wait(5.0)) throw std::runtime_error("Second GET execution did not arrive");
+    testEq(source->executions.size(), 2u);
+    source->executions[0]->onCancel([source]() { ++source->nStaleCanceled; source->currentCanceled.signal(); });
+    sendNativeGetControl(get, true, false);
+    testTrue(source->currentCanceled.wait(5.0));
+    testEq(source->nFirstCanceled.load(), 1u);
+    testEq(source->nCurrentCanceled.load(), 1u);
+    testEq(source->nStaleCanceled.load(), 0u);
+    sendNativeGetControl(get, false, true);
+    if(!source->entered.wait(5.0)) throw std::runtime_error("Third GET execution did not arrive");
+    testEq(source->executions.size(), 3u);
+    auto stale=source->prototype.cloneEmpty();
+    stale["value"]=999;
+    source->executions[0]->reply(stale);
+    source->executions[0]->error("late canceled error");
+    source->executions[1]->reply(stale, RemoteStatus(RemoteStatus::Warning, "late warning", "old stack"));
+    source->executions[1]->error(RemoteStatus(RemoteStatus::Fatal, "late fatal", "old stack"));
+    source->executions[0]->logRemote(Level::Warn, "stale remote log");
+    // Same-connection round trip drains earlier server work and received frames.
+    cli.info("generation").exec()->wait(5.0);
+    testFalse(completed.wait(0.0));
+    auto fresh=source->prototype.cloneEmpty();
+    fresh["value"]=89;
+    source->executions[2]->reply(fresh);
+    if(!completed.wait(5.0)) throw std::runtime_error("Current GET reply did not arrive");
+    testFalse(result.error());
+    testEq(result()["value"].as<int32_t>(), 89);
+    source->executions.clear();
+}
