+void noReplay(unsigned kind) {
+    auto source=std::make_shared<AdmissionSource>(); source->drop=true;
+    auto serv=server::Config::isolated().build().addSource("admission", source).start();
+    auto cli=serv.clientConfig().build();
+    std::atomic<unsigned> guards{0};
+    auto guard=[&]() { ++guards; };
+    std::shared_ptr<client::Operation> op;
+    if(kind==0) op=cli.get("value").record("process", true).beforeSend(guard).exec();
+    else if(kind==1) op=cli.put("value").fetchPresent(false).set("value", 42).beforeSend(guard).exec();
+    else op=cli.rpc("value", source->prototype).beforeSend(guard).exec();
+    testThrows<client::Disconnect>([&]() { op->wait(5.0); });
+    // A successful new operation proves the target channel has reconnected.
+    testTrue(bool(cli.info("value").exec()->wait(5.0)));
+    testEq(guards.load(), 1u);
+    testEq(kind==0 ? source->gets.load() : kind==1 ? source->puts.load() : source->rpcs.load(), 1u);
+}
