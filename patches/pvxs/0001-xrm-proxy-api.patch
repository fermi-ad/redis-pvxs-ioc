+struct DelayedProxySource : AdmissionSource {
+    epicsEvent setup;
+    std::unique_ptr<server::ProxySetupOp> held;
+    std::atomic<unsigned> executions{0};
+    void onCreate(std::unique_ptr<server::ChannelControl>&& raw) override {
+        raw->onOp([this](std::unique_ptr<server::ConnectOp>&& op) { op->connect(prototype); });
+        raw->onProxy([this](std::unique_ptr<server::ProxySetupOp>&& op) {
+            op->onExec([this](std::unique_ptr<server::ProxyExecOp>&& exec, ProxyRequest&&) {
+                ++executions; exec->reply();
+            });
+            held=std::move(op); setup.signal();
