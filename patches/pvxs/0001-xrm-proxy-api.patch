diff --git a/src/clientproxy.cpp b/src/clientproxy.cpp
new file mode 100644
--- /dev/null
+++ b/src/clientproxy.cpp
@@ -0,0 +1,311 @@
+/** Project-owned PVA PROCESS, PUT_GET, and ARRAY client support. */
+#include <limits>
+#include <pvxs/log.h>
+#include "clientimpl.h"
+
+namespace pvxs {
+int xrmProxyApiVersion() { return 1; }
+namespace client {
+DEFINE_LOGGER(proxyio, "pvxs.client.proxy");
+namespace {
+struct ProxyOp final : OperationBase {
+    std::weak_ptr<ProxyOp> self;
+    const ProxyKind kind;
+    Value pvRequest;
+    ProxyPrototype prototype;
+    Value putCache, getCache;
+    std::function<void(const ProxyPrototype&, const RemoteStatus&)> onInit;
+    std::function<void(Result&&)> setupResult, completion;
+    std::function<void()> beforeSend;
+    ProxyRequest request;
+    bool pending = false;
+    bool setupSucceeded = false;
+    enum { Connecting, Creating, Idle, Executing, Done } state = Connecting;
+    uint8_t expected = 0;
+
+    ProxyOp(ProxyKind kind, const evbase& loop, const std::string& name)
+        :OperationBase(operation_t(uint8_t(kind)), loop, name), kind(kind) {}
+    ~ProxyOp() { if(onWorker && loop.assertInRunningLoop()) cancelImpl(true); }
+
+    // std::function move need not clear its source on every standard library.
+    // Swap when consuming a callback so later cancellation cannot deliver twice.
+    static std::function<void(Result&&)> take(std::function<void(Result&&)>& source) {
+        std::function<void(Result&&)> result;
+        result.swap(source);
+        return result;
+    }
+    static void deliver(std::function<void(Result&&)> cb, Result&& result) {
+        if(!cb) return;
+        try { cb(std::move(result)); }
+        catch(std::exception& e) { log_exc_printf(proxyio, "Proxy result callback: %s\n", e.what()); }
+        catch(...) { log_err_printf(proxyio, "%s\n", "Proxy result callback threw"); }
+    }
+    void failSetup(const std::exception_ptr& error, const RemoteStatus& status = RemoteStatus{}) {
+        auto cb(take(completion));
+        std::function<void(Result&&)> setup;
+        if(!setupSucceeded) setup.swap(setupResult);
+        else setupResult={};
+        cancelImpl(true);
+        deliver(std::move(setup), Result(error, status));
+        deliver(std::move(cb), Result(error, status));
+    }
+    bool cancelImpl(bool implicit) {
+        bool active = state!=Done;
+        auto cb(take(completion));
+        if(chan && chan->conn && (state==Creating || state==Idle || state==Executing)) {
+            chan->conn->sendDestroyRequest(chan->sid, ioid);
+            chan->conn->opByIOID.erase(ioid);
+            chan->opByIOID.erase(ioid);
+        }
+        state = Done;
+        pending = false;
+        if(!implicit) deliver(std::move(cb), Result(std::make_exception_ptr(Interrupted())));
+        return active;
+    }
+    bool cancel() override final {
+        bool ret=false;
+        loop.tryCall([this, &ret]() {
+            ret=cancelImpl(false);
+            setupResult={}; onInit={}; beforeSend={};
+        });
+        return ret;
+    }
+    void _reExecGet(std::function<void(Result&&)>&& cb) override final {
+        deliver(std::move(cb), Result(std::make_exception_ptr(std::logic_error("Use proxy execute()"))));
+    }
+    void _reExecPut(const Value&, std::function<void(Result&&)>&& cb) override final {
+        deliver(std::move(cb), Result(std::make_exception_ptr(std::logic_error("Use proxy execute()"))));
+    }
+    void _executeProxy(const ProxyRequest& req, std::function<void(Result&&)>&& cb) override final {
+        auto hold(self.lock());
+        loop.dispatch([hold, req, cb]() mutable {
+            if(hold->state==Done || hold->state==Executing || hold->pending) {
+                deliver(std::move(cb), Result(std::make_exception_ptr(std::logic_error("Proxy operation is closed or busy"))));
+                return;
+            }
+            hold->request=req;
+            hold->completion.swap(cb);
+            hold->pending=true;
+            if(hold->state==Idle) hold->sendExecution();
+        });
+    }
+    uint8_t validate() {
+        using A=ProxyAction;
+        const auto& req=request;
+        switch(kind) {
+        case ProxyKind::Process:
+            if(req.action==A::Process) return 0;
+            break;
+        case ProxyKind::PutGet:
+            if(req.action==A::GetPut) return 0x80;
+            if(req.action==A::GetGet) return 0x40;
+            if(req.action==A::PutGet) {
+                if(!req.value || !req.value.equalType(prototype.put))
+                    throw std::invalid_argument("PUT_GET value does not match put prototype");
+                return 0;
+            }
+            break;
+        case ProxyKind::Array:
+            // PVA sizes use a compact unsigned 32-bit wire encoding.
+            if(req.offset>0xffffffffu || req.count>0xffffffffu || req.stride>0xffffffffu || req.length>0xffffffffu)
+                throw std::invalid_argument("ARRAY argument exceeds wire size limit");
+            if((req.action==A::ArrayGet || req.action==A::ArrayPut) && !req.stride)
+                throw std::invalid_argument("ARRAY stride must be positive");
+            if(req.action==A::ArrayGet) return 0x40;
+            if(req.action==A::ArraySetLength) return 0x80;
+            if(req.action==A::ArrayGetLength) return 0x04;
+            if(req.action==A::ArrayPut) {
+                if(!req.value || !req.value.equalType(prototype.put))
+                    throw std::invalid_argument("ARRAY value does not match prototype");
+                if(req.count && req.count>req.value.as<shared_array<const void>>().size())
+                    throw std::invalid_argument("ARRAY count exceeds supplied value length");
+                return 0;
+            }
+            break;
+        }
+        throw std::invalid_argument("Action is not valid for proxy kind");
+    }
+    void sendExecution() {
+        Value payload;
+        try {
+            expected=validate();
+            payload=request.value;
+            if(request.action==ProxyAction::ArrayPut && request.count) {
+                auto array(payload.as<shared_array<const void>>());
+                payload=payload.cloneEmpty();
+                payload=shared_array<const void>(array.dataPtr(), size_t(request.count), array.original_type());
+            }
+            // Admission hook is the last user callback before serialization.
+            if(beforeSend) beforeSend();
+        } catch(...) {
+            pending=false;
+            deliver(take(completion), Result(std::current_exception()));
+            return;
+        }
+        // The hook can synchronously cancel this handle.
+        if(state!=Idle || !pending) return;
+        auto conn(chan->conn);
+        evbuffer_drain(conn->txBody.get(), evbuffer_get_length(conn->txBody.get()));
+        bool good;
+        {
+            EvOutBuf out(conn->sendBE, conn->txBody.get());
+            to_wire(out, chan->sid); to_wire(out, ioid); to_wire(out, expected);
+            if(kind==ProxyKind::PutGet && request.action==ProxyAction::PutGet) {
+                to_wire_valid(out, payload);
+            } else if(kind==ProxyKind::Array) {
+                switch(request.action) {
+                case ProxyAction::ArrayGet:
+                    to_wire(out, Size{size_t(request.offset)});
+                    to_wire(out, Size{size_t(request.count)});
+                    to_wire(out, Size{size_t(request.stride)});
+                    break;
+                case ProxyAction::ArrayPut:
+                    to_wire(out, Size{size_t(request.offset)});
+                    to_wire(out, Size{size_t(request.stride)});
+                    to_wire_full(out, payload);
+                    break;
+                case ProxyAction::ArraySetLength: to_wire(out, Size{size_t(request.length)}); break;
+                default: break;
+                }
+            }
+            good=out.good();
+        }
+        pending=false;
+        if(!good) {
+            evbuffer_drain(conn->txBody.get(), evbuffer_get_length(conn->txBody.get()));
+            deliver(take(completion), Result(std::make_exception_ptr(std::runtime_error("Unable to serialize proxy request"))));
+            return;
+        }
+        if(kind==ProxyKind::PutGet && request.action==ProxyAction::PutGet) {
+            auto written=request.value.cloneEmpty();
+            // Native decoding expands parent marks to leaf marks.  Locally
+            // supplied Values may only mark a parent; copy covered leaves
+            // explicitly, since clone() only copies directly marked leaves.
+            for(auto field : request.value.iall()) {
+                if(field.type()!=TypeCode::Struct && field.isMarked(true))
+                    written[request.value.nameOf(field)].assign(field);
+            }
+            cache_sync(putCache, written);
+        }
+        state=Executing;
+        chan->statTx+=conn->enqueueTxBody(pva_app_msg_t(uint8_t(kind)));
+    }
+    void createOp() override final {
+        if(state!=Connecting) return;
+        auto conn(chan->conn);
+        evbuffer_drain(conn->txBody.get(), evbuffer_get_length(conn->txBody.get()));
+        {
+            EvOutBuf out(conn->sendBE, conn->txBody.get());
+            to_wire(out, chan->sid); to_wire(out, ioid); to_wire(out, uint8_t(0x08));
+            to_wire(out, Value::Helper::desc(pvRequest)); to_wire_full(out, pvRequest);
+        }
+        state=Creating;
+        chan->statTx+=conn->enqueueTxBody(pva_app_msg_t(uint8_t(kind)));
+    }
+    void disconnected(const std::shared_ptr<OperationBase>& handle) override final {
+        if(state==Done || state==Connecting) return;
+        // Fail every admitted execution; no mutation is ever replayed.
+        if(state==Executing || pending) {
+            failSetup(std::make_exception_ptr(Disconnect()));
+        } else {
+            state=Connecting;
+            setupSucceeded=false;
+            chan->pending.push_back(handle);
+        }
+    }
+};
+}
+
+void Connection::handle_proxy(pva_app_msg_t cmd) {
+    const auto rxlen=8u+evbuffer_get_length(segBuf.get());
+    EvInBuf in(peerBE, segBuf.get(), 16);
+    uint32_t ioid=0;
+    uint8_t subcmd=0;
+    Status status;
+    from_wire(in, ioid); from_wire(in, subcmd); from_wire(in, status);
+    auto found=opByIOID.find(ioid);
+    if(!in.good()) { bev.reset(); return; }
+    auto handle=found==opByIOID.end() ? std::shared_ptr<OperationBase>() : found->second.handle.lock();
+    if(!handle) { rxRegistryDirty=true; return; }
+    if(uint8_t(handle->op)!=uint8_t(cmd)) { bev.reset(); return; }
+    auto op=static_cast<ProxyOp*>(handle.get());
+    bool init=subcmd&0x08;
+    if((init && op->state!=ProxyOp::Creating) || (!init && (op->state!=ProxyOp::Executing || subcmd!=op->expected))) {
+        bev.reset(); return;
+    }
+    Value data;
+    if(status.isSuccess()) {
+        if(init) {
+            if(cmd==CMD_PUT_GET) {
+                from_wire_type(in, rxRegistry, op->prototype.put);
+                from_wire_type(in, rxRegistry, op->prototype.get);
+                op->putCache=op->prototype.put.cloneEmpty();
+                op->getCache=op->prototype.get.cloneEmpty();
+            } else if(cmd==CMD_ARRAY) {
+                from_wire_type(in, rxRegistry, op->prototype.put);
+                op->prototype.get=op->prototype.put;
+                if(!op->prototype.put.type().isarray()) in.fault(__FILE__, __LINE__);
+            }
+        } else if(cmd==CMD_PUT_GET) {
+            auto& cache = subcmd&0x80 ? op->putCache : op->getCache;
+            if(!cache) cache=(subcmd&0x80 ? op->prototype.put : op->prototype.get).cloneEmpty();
+            data=cache.cloneEmpty();
+            from_wire_valid(in, rxRegistry, data);
+            if(in.good()) cache_sync(cache, data);
+        } else if(cmd==CMD_ARRAY && subcmd&0x40) {
+            data=op->prototype.get.cloneEmpty();
+            from_wire_full(in, rxRegistry, data);
+        } else if(cmd==CMD_ARRAY && subcmd&0x04) {
+            Size length{0}; from_wire(in, length);
+            data=TypeDef(TypeCode::UInt64).create(); data=uint64_t(length.size);
+        }
+    }
+    if(!in.good()) { bev.reset(); return; }
+    op->chan->statRx+=rxlen;
+    if(init) {
+        if(!status.isSuccess()) {
+            auto error=std::make_exception_ptr(RemoteError(remoteStatus(status)));
+            op->failSetup(error, remoteStatus(status));
+            return;
+        }
+        op->state=ProxyOp::Idle;
+        try { if(op->onInit) op->onInit(op->prototype, remoteStatus(status)); }
+        catch(...) {
+            auto error=std::current_exception(); op->failSetup(error); return;
+        }
+        op->setupSucceeded=true;
+        if(op->state==ProxyOp::Idle && op->pending) op->sendExecution();
+    } else {
+        op->state=ProxyOp::Idle;
+        Result result=status.isSuccess() ? Result(std::move(data), peerName, remoteStatus(status)) : Result(std::make_exception_ptr(RemoteError(remoteStatus(status))), remoteStatus(status));
+        ProxyOp::deliver(ProxyOp::take(op->completion), std::move(result));
+    }
+}
+void Connection::handle_PROCESS() { handle_proxy(CMD_PROCESS); }
+void Connection::handle_PUT_GET() { handle_proxy(CMD_PUT_GET); }
+void Connection::handle_ARRAY() { handle_proxy(CMD_ARRAY); }
+
+std::shared_ptr<ProxyOperation> ProxyBuilder::exec() {
+    if(!ctx || _name.empty()) throw std::logic_error("Proxy requires a context and channel name");
+    auto context(ctx->impl->shared_from_this());
+    auto op=std::make_shared<ProxyOp>(_kind, context->tcp_loop, _name);
+    op->self=op;
+    op->pvRequest=_buildReq(); op->onInit.swap(_onInit);
+    op->setupResult.swap(_result); op->beforeSend.swap(_beforeSend);
+    auto syncCancel=_syncCancel;
+    std::shared_ptr<ProxyOperation> external(op.get(), [op, syncCancel](ProxyOperation*) mutable {
+        auto temp(std::move(op)); auto loop(temp->loop);
+        loop.tryInvoke(syncCancel, std::bind([](std::shared_ptr<ProxyOp>& hold) { hold->cancelImpl(true); }, std::move(temp)));
+    });
+    auto name(_name), server(_server);
+    context->tcp_loop.dispatch([op, context, name, server]() {
+        op->onWorker=true;
+        try {
+            op->chan=Channel::build(context, name, server);
+            op->chan->pending.push_back(op); op->chan->createOperations();
+        } catch(...) { op->failSetup(std::current_exception()); }
+    });
+    return external;
+}
+} // namespace client
+} // namespace pvxs
