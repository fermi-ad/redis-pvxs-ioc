+void nativeMonitorStatus() {
+    auto source=std::make_shared<StatusSource>();
+    auto serv=server::Config::isolated().build().addSource("status", source).start();
+    auto cli=serv.clientConfig().build();
+    epicsEvent available;
+    auto sub=cli.monitor("warn").maskDisconnected(false)
+        .onInit([&](client::Subscription&, const Value&, const RemoteStatus& status) { checkStatus(status, warning()); })
+        .event([&](client::Subscription&) { available.signal(); }).exec();
+    bool sawValue=false, finished=false;
+    for(unsigned attempt=0; attempt<5 && !finished; ++attempt) {
+        testOk1(available.wait(5.0));
+        try {
+            while(true) {
+                auto event=sub->popEvent();
+                if(!event.value) break;
+                sawValue=true; checkStatus(event.status, RemoteStatus{});
+            }
+        } catch(client::Finished& final) { finished=true; checkStatus(final.status(), warning()); }
+    }
+    testTrue(sawValue); testTrue(finished);
+    sub->cancel();
+    auto failed=cli.monitor("fatal").maskDisconnected(false)
+        .event([&](client::Subscription&) { available.signal(); }).exec();
+    bool remoteError=false;
+    for(unsigned attempt=0; attempt<5 && !remoteError; ++attempt) {
+        testOk1(available.wait(5.0));
+        try { while(failed->popEvent().value) {} }
+        catch(client::RemoteError& error) { remoteError=true; checkStatus(error.status(), remoteFailure(true)); }
+    }
+    testTrue(remoteError);
+}
