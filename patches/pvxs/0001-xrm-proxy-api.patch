+ * in file LICENSE that is included with this distribution.
+ */
+#include <limits>
+#include <pvxs/log.h>
+#include "serverconn.h"
+
+namespace pvxs { namespace impl {
+DEFINE_LOGGER(proxysetup, "pvxs.tcp.setup");
+
+namespace {
+
+ProxyKind proxyKind(pva_app_msg_t cmd)
+{
+    return cmd==CMD_PROCESS ? ProxyKind::Process : cmd==CMD_PUT_GET ? ProxyKind::PutGet : ProxyKind::Array;
+}
+
+struct ServerProxy final : ServerOp {
+    const pva_app_msg_t cmd;
+    Value pvRequest;
+    Type putType, getType;
+    uint8_t subcmd = 0u;
+    uint64_t generation = 0u;
+    ProxyAction action = ProxyAction::Process;
+    std::function<void(std::unique_ptr<server::ProxyExecOp>&&, ProxyRequest&&)> onExec;
+
+    ServerProxy(const std::shared_ptr<ServerChan>& chan, uint32_t ioid, pva_app_msg_t cmd)
+        :ServerOp(chan, ioid), cmd(cmd)
+    {}
+
+    void cleanup() override final
+    {
+        ServerOp::cleanup();
+        onExec = nullptr;
+    }
+
+    void show(std::ostream& strm) const override final
+    {
+        strm<<(cmd==CMD_PROCESS ? "PROCESS" : cmd==CMD_PUT_GET ? "PUT_GET" : "ARRAY")<<'\n';
+    }
+
+    // Always called on the connection worker.  Generation prevents a delayed reply
+    // to a canceled request from completing a later request using the same IOID.
+    void reply(uint64_t seq, const Value& value, uint64_t length, const std::string& error)
+    {
+        reply(seq, value, length, error.empty() ? Status{} : Status::error(error));
+    }
+    void reply(uint64_t seq, const Value& value, uint64_t length, const Status& status)
+    {
+        if((state!=Creating && state!=Executing) || seq!=generation)
+            return;
+        auto ch = chan.lock();
+        if(!ch)
+            return;
+        auto conn = ch->conn.lock();
+        if(!conn || !conn->connection() || conn->state==ConnBase::Disconnected)
+            return;
+
+        auto sts = status;
+        if(sts.isSuccess() && state==Executing) {
+            auto expected = action==ProxyAction::GetPut ? putType : getType;
+            const bool hasValue = cmd==CMD_PUT_GET || action==ProxyAction::ArrayGet;
+            if(hasValue && (!value || Value::Helper::desc(value)!=expected.get()))
+                sts = Status::error("Reply must use the prototype provided to connect()");
+            else if(!hasValue && value)
+                sts = Status::error("Operation reply must not include a value");
+            else if(action==ProxyAction::ArrayGetLength && length>std::numeric_limits<uint32_t>::max())
+                sts = Status::error("Array length exceeds the PVA size limit");
+        }
+
+        const bool creating = state==Creating;
+        (void)evbuffer_drain(conn->txBody.get(), evbuffer_get_length(conn->txBody.get()));
+        {
+            EvOutBuf R(conn->sendBE, conn->txBody.get());
+            to_wire(R, ioid);
+            to_wire(R, subcmd);
+            to_wire(R, sts);
+            if(sts.isSuccess()) {
+                if(creating) {
+                    if(cmd==CMD_PUT_GET) {
+                        to_wire(R, putType.get());
+                        to_wire(R, getType.get());
+                    } else if(cmd==CMD_ARRAY) {
+                        to_wire(R, getType.get());
+                    }
+                } else if(cmd==CMD_PUT_GET) {
+                    to_wire_valid(R, value);
+                } else if(action==ProxyAction::ArrayGet) {
+                    to_wire_full(R, value);
+                } else if(action==ProxyAction::ArrayGetLength) {
+                    to_wire(R, Size{size_t(length)});
+                }
+            }
+            if(!R.good())
+                throw std::runtime_error("Unable to encode proxy reply");
+        }
+        ch->statTx += conn->enqueueTxBody(cmd);
+        onCancel = nullptr;
+        if((creating && !sts.isSuccess()) || (!creating && (subcmd&0x10)))
+            cleanup();
+        else
+            state = Idle;
+    }
+};
+
+struct ProxyConnect final : server::ProxySetupOp {
+    const std::weak_ptr<server::Server::Pvt> server;
+    const std::weak_ptr<ServerProxy> op;
+
+    ProxyConnect(ServerConn* conn, const std::shared_ptr<ServerChan>& chan, const std::shared_ptr<ServerProxy>& op)
+        :ProxySetupOp(chan->name, conn->cred, proxyKind(op->cmd), op->pvRequest)
+        ,server(conn->iface->server->internal_self), op(op)
+    {}
+    ~ProxyConnect() { error("Operation setup was not completed"); }
+
+    void connect(const ProxyPrototype& proto) override final
+    {
+        connect(proto, RemoteStatus());
+    }
+    void connect(const ProxyPrototype& proto, const RemoteStatus& status) override final
+    {
+        if(!status.isSuccess()) {
+            error(status);
+            return;
+        }
+        if(kind()==ProxyKind::Process && (proto.put || proto.get))
+            throw std::invalid_argument("PROCESS does not have value prototypes");
+        if(kind()==ProxyKind::PutGet && (!proto.put || !proto.get ||
+                proto.put.type()!=TypeCode::Struct || proto.get.type()!=TypeCode::Struct))
+            throw std::invalid_argument("PUT_GET requires put and get structure prototypes");
+        if(kind()==ProxyKind::Array && (!proto.put || !proto.get ||
+                !proto.get.type().isarray() || !proto.put.equalType(proto.get)))
+            throw std::invalid_argument("ARRAY requires matching root array prototypes");
+        auto serv = server.lock();
+        if(!serv)
+            return;
+        serv->acceptor_loop.call([this, &proto, &status]() {
+            if(auto oper = op.lock()) {
+                if(oper->state!=ServerOp::Creating)
+                    return;
+                oper->putType = Value::Helper::type(proto.put);
+                oper->getType = Value::Helper::type(proto.get);
+                oper->reply(oper->generation, Value(), 0u, serverStatus(status));
+            }
+        });
+    }
+
+    void error(const std::string& msg) override final
+    {
+        if(msg.empty())
+            throw std::invalid_argument("Must provide error message");
+        if(auto serv = server.lock()) {
+            auto weak = op;
+            serv->acceptor_loop.dispatch([weak, msg]() {
+                if(auto oper = weak.lock())
+                    if(oper->state==ServerOp::Creating)
+                        oper->reply(oper->generation, Value(), 0u, msg);
+            });
+        }
+    }
+
+    void error(const RemoteStatus& status) override final
+    {
+        if(auto serv = server.lock()) {
+            auto weak = op;
+            serv->acceptor_loop.dispatch([weak, status]() {
+                if(auto oper = weak.lock())
+                    if(oper->state==ServerOp::Creating)
+                        oper->reply(oper->generation, Value(), 0u, serverStatus(status));
+            });
+        }
+    }
+
+    void onExec(std::function<void(std::unique_ptr<server::ProxyExecOp>&&, ProxyRequest&&)>&& fn) override final
+    {
+        if(auto serv = server.lock())
+            serv->acceptor_loop.call([this, &fn]() {
+                if(auto oper = op.lock())
+                    oper->onExec = std::move(fn);
+            });
+    }
+    void onClose(std::function<void(const std::string&)>&& fn) override final
+    {
+        if(auto serv = server.lock())
+            serv->acceptor_loop.call([this, &fn]() {
+                if(auto oper = op.lock())
+                    oper->onClose = std::move(fn);
+            });
+    }
+    void logRemote(Level lvl, const std::string& msg) override final { doLogRemote(this, lvl, msg); }
+};
+
+struct ProxyExec final : server::ProxyExecOp {
+    const std::weak_ptr<server::Server::Pvt> server;
+    const std::weak_ptr<ServerProxy> op;
+    const uint64_t generation;
+
+    ProxyExec(ServerConn* conn, const std::shared_ptr<ServerChan>& chan, const std::shared_ptr<ServerProxy>& oper)
+        :ProxyExecOp(chan->name, conn->cred, proxyKind(oper->cmd), oper->action, oper->pvRequest)
+        ,server(conn->iface->server->internal_self), op(oper), generation(oper->generation)
+    {}
+    ~ProxyExec() { error("Operation execution was not completed"); }
+
+    void send(const Value& value, uint64_t length, const std::string& msg)
+    {
+        send(value, length, msg.empty() ? Status{} : Status::error(msg));
+    }
+    void send(const Value& value, uint64_t length, const Status& status)
+    {
+        if(auto serv = server.lock()) {
+            auto weak = op;
+            auto seq = generation;
+            serv->acceptor_loop.dispatch([weak, seq, value, length, status]() {
+                if(auto oper = weak.lock())
+                    if(oper->state==ServerOp::Executing)
+                        oper->reply(seq, value, length, status);
+            });
+        }
+    }
+    void reply() override final { send(Value(), 0u, std::string()); }
+    void reply(const Value& value) override final { send(value, 0u, std::string()); }
+    void reply(const Value& value, const RemoteStatus& status) override final {
+        send(value, 0u, serverStatus(status));
+    }
+    void reply(const RemoteStatus& status) override final {
+        send(Value(), 0u, serverStatus(status));
+    }
+    void replyLength(uint64_t length) override final { replyLength(length, RemoteStatus()); }
+    void replyLength(uint64_t length, const RemoteStatus& status) override final {
+        if(action()!=ProxyAction::ArrayGetLength)
+            throw std::logic_error("replyLength() is only valid for ARRAY getLength");
+        send(Value(), length, serverStatus(status));
+    }
+    void error(const std::string& msg) override final {
+        if(msg.empty())
+            throw std::invalid_argument("Must provide error message");
+        send(Value(), 0u, msg);
+    }
+    void error(const RemoteStatus& status) override final {
+        send(Value(), 0u, serverStatus(status));
+    }
+    void onCancel(std::function<void()>&& fn) override final
+    {
+        if(auto serv = server.lock())
+            serv->acceptor_loop.call([this, &fn]() {
+                if(auto oper = op.lock())
+                    if(oper->state==ServerOp::Executing && generation==oper->generation)
+                        oper->onCancel = std::move(fn);
+            });
+    }
+    Timer _timerOneShot(double delay, std::function<void()>&& fn) override final
+    {
+        auto serv = server.lock();
+        if(!serv)
+            throw std::logic_error("Can't start timer on dead server");
+        return Timer::Pvt::buildOneShot(delay, serv->acceptor_loop.internal(), std::move(fn));
+    }
+    void logRemote(Level lvl, const std::string& msg) override final { doLogRemote(this, lvl, msg); }
+};
+
+} // namespace
+
+void ServerConn::handle_PROXY(pva_app_msg_t cmd)
+{
+    const auto rxlen = 8u + evbuffer_get_length(segBuf.get());
+    EvInBuf M(peerBE, segBuf.get(), 16);
+    uint32_t sid=0u, ioid=0u;
+    uint8_t subcmd=0u;
+    from_wire(M, sid);
+    from_wire(M, ioid);
+    from_wire(M, subcmd);
+    if(!M.good()) {
+        bev.reset();
+        return;
+    }
+
+    auto fail = [this, cmd, ioid, subcmd](const std::string& msg) {
+        (void)evbuffer_drain(txBody.get(), evbuffer_get_length(txBody.get()));
+        {
+            EvOutBuf R(sendBE, txBody.get());
+            to_wire(R, ioid);
+            to_wire(R, subcmd);
+            to_wire(R, Status::error(msg));
+        }
+        enqueueTxBody(cmd);
+    };
+
+    if(subcmd&0x08) {
+        Value request;
+        from_wire_type_value(M, rxRegistry, request);
+        if(!M.good()) {
+            bev.reset();
+            return;
+        }
+        auto chan = lookupSID(sid);
+        if(!chan) {
+            fail("Unknown channel");
+            return;
+        }
+        if(opByIOID.count(ioid)) {
+            fail("Operation identifier is already in use");
+            return;
+        }
+        chan->statRx += rxlen;
+        auto oper = std::make_shared<ServerProxy>(chan, ioid, cmd);
+        oper->state = ServerOp::Creating;
+        oper->subcmd = subcmd;
+        oper->pvRequest = request;
+        opByIOID[ioid] = oper;
+        chan->opByIOID[ioid] = oper;
+        std::unique_ptr<server::ProxySetupOp> ctrl(new ProxyConnect(this, chan, oper));
+        try {
+            if(chan->onProxy)
+                chan->onProxy(std::move(ctrl));
+            else
+                ctrl->error("Native proxy operation is not implemented for this PV");
+        } catch(std::exception& e) {
+            oper->reply(oper->generation, Value(), 0u, e.what());
+        }
+        return;
+    }
+
+    auto it = opByIOID.find(ioid);
+    auto oper = it==opByIOID.end() ? std::shared_ptr<ServerProxy>() : std::dynamic_pointer_cast<ServerProxy>(it->second);
+    auto chan = oper ? oper->chan.lock() : std::shared_ptr<ServerChan>();
+    if(!oper || !chan || chan->sid!=sid || oper->cmd!=cmd) {
+        rxRegistryDirty = true;
+        fail("Unknown or incompatible operation");
+        return;
+    }
+    if(oper->state!=ServerOp::Idle) {
+        rxRegistryDirty = true;
+        fail("Operation is not ready for execution");
+        return;
+    }
+
+    ProxyRequest request;
+    if(cmd==CMD_PROCESS) {
+        request.action = ProxyAction::Process;
+    } else if(cmd==CMD_PUT_GET) {
+        request.action = (subcmd&0x40) ? ProxyAction::GetGet : (subcmd&0x80) ? ProxyAction::GetPut : ProxyAction::PutGet;
+        if(request.action==ProxyAction::PutGet) {
+            request.value = Value::Helper::build(oper->putType);
+            from_wire_valid(M, rxRegistry, request.value);
+        }
+    } else {
+        Size offset{}, count{}, stride{}, length{};
+        if(subcmd&0x40) {
+            request.action = ProxyAction::ArrayGet;
+            from_wire(M, offset);
+            from_wire(M, count);
+            from_wire(M, stride);
+        } else if(subcmd&0x80) {
+            request.action = ProxyAction::ArraySetLength;
+            from_wire(M, length);
+        } else if(subcmd&0x04) {
+            request.action = ProxyAction::ArrayGetLength;
+        } else {
+            request.action = ProxyAction::ArrayPut;
+            from_wire(M, offset);
+            from_wire(M, stride);
+            request.value = Value::Helper::build(oper->putType);
+            from_wire_full(M, rxRegistry, request.value);
+            if(M.good())
+                count.size = request.value.as<shared_array<const void>>().size();
+        }
+        request.offset = offset.size;
+        request.count = count.size;
+        request.stride = stride.size;
+        request.length = length.size;
+    }
+    if(!M.good()) {
+        bev.reset();
+        return;
+    }
+    chan->statRx += rxlen;
+    oper->subcmd = subcmd;
+    oper->action = request.action;
+    oper->generation++;
+    oper->state = ServerOp::Executing;
+    std::unique_ptr<server::ProxyExecOp> ctrl(new ProxyExec(this, chan, oper));
+    try {
+        if(oper->onExec)
+            oper->onExec(std::move(ctrl), std::move(request));
+        else
+            ctrl->error("Native operation execution is not implemented for this PV");
+    } catch(std::exception& e) {
+        oper->reply(oper->generation, Value(), 0u, e.what());
+    }
+}
+
+void ServerConn::handle_PROCESS() { handle_PROXY(CMD_PROCESS); }
+void ServerConn::handle_PUT_GET() { handle_PROXY(CMD_PUT_GET); }
+void ServerConn::handle_ARRAY() { handle_PROXY(CMD_ARRAY); }
+
+}} // namespace pvxs::impl
